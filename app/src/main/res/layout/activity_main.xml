<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raizMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- BOTÓN DE TEMA (Movido al XML) -->
        <ImageView
            android:id="@+id/btnToggleTemaUI"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|top"
            android:layout_margin="@dimen/space_md"
            android:background="?android:attr/selectableItemBackgroundBorderless" 
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:contentDescription="Alternar Tema" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingTop="48dp"
            android:paddingBottom="@dimen/space_xl">

            <!-- TÍTULOS (Desde strings.xml y dimens.xml) -->
            <TextView
                android:id="@+id/txtTituloMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="@dimen/text_display"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/space_xs"/>

            <TextView
                android:id="@+id/txtSubtituloMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_subtitle"
                android:textSize="@dimen/text_sm"
                android:layout_marginBottom="@dimen/space_xl"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- TIMELINE (Círculos aumentados a 36dp para UX táctil) -->
                <LinearLayout
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/circuloPaso1"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="✓"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <View
                        android:id="@+id/lineaProgreso"
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/circuloPaso2"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="2"
                        android:textSize="@dimen/text_sm"
                        android:gravity="center" />

                </LinearLayout>

                <!-- TARJETAS DE PASOS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <LinearLayout
                        android:id="@+id/cardPaso1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md"
                        android:layout_marginBottom="@dimen/space_md"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tituloPaso1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_step1_title"
                            android:textSize="@dimen/text_md"
                            android:textStyle="bold"
                            android:layout_marginBottom="@dimen/space_xs"/>

                        <TextView
                            android:id="@+id/subtextoPaso1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_step1_desc_off"
                            android:textSize="@dimen/text_sm"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/btnPaso1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_step1_btn_off"
                            android:textSize="@dimen/text_sm"
                            android:textStyle="bold"
                            android:paddingHorizontal="@dimen/space_md"
                            android:paddingVertical="@dimen/space_sm"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardPaso2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tituloPaso2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_step2_title"
                            android:textSize="@dimen/text_md"
                            android:textStyle="bold"
                            android:layout_marginBottom="@dimen/space_xs"/>

                        <TextView
                            android:id="@+id/subtextoPaso2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_step2_desc"
                            android:textSize="@dimen/text_sm"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/btnPaso2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_step2_btn_off"
                            android:textSize="@dimen/text_sm"
                            android:paddingHorizontal="@dimen/space_md"
                            android:paddingVertical="@dimen/space_sm"/>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- BANNER DE ÉXITO -->
            <LinearLayout
                android:id="@+id/bannerActivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/space_md"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/iconoBanner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textSize="@dimen/text_md"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/textoBanner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_banner_active"
                    android:textSize="@dimen/text_sm"
                    android:textStyle="bold"/>

            </LinearLayout>
        </LinearLayout>

        <!-- BOTÓN DE CONFIGURACIONES -->
        <ImageView
            android:id="@+id/btnConfiguraciones"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|top"
            android:layout_margin="@dimen/space_md"
            android:background="?android:attr/selectableItemBackgroundBorderless" 
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_engrane"
            android:contentDescription="@string/settings_title" />
    </FrameLayout>
</ScrollView>